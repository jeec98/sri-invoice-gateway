# ==============================================================================
# SRI INVOICE GATEWAY — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database (Prisma ORM)
# ------------------------------------------------------------------------------
# Local Docker Compose (matches docker-compose.yml port 5435):
POSTGRES_USER=sri_user
POSTGRES_PASSWORD=sri_password
POSTGRES_DB=sri_gateway_db
DATABASE_URL="postgresql://sri_user:sri_password@localhost:5435/sri_gateway_db?schema=public"

# Cloud Example (Neon / Supabase / Railway / RDS):
# DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<dbname>?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Redis Configuration (BullMQ Asynchronous Queue)
# ------------------------------------------------------------------------------
# Local Docker Compose (matches docker-compose.yml port 6379):
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cloud Example (Railway Redis / Upstash / Redis Cloud):
# REDIS_HOST=your-redis-host.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# ------------------------------------------------------------------------------
# 4. Cryptography, Certificates & Multi-Tenant Security
# ------------------------------------------------------------------------------
# REQUIRED in production: 64-character hex string (32 bytes / 256 bits) for AES-256-GCM encryption of .p12 passwords.
# Generate a new key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Local directory for AES-256-GCM encrypted (0600) backup of uploaded .p12.enc certificates
# Note: Certificates are also stored encrypted in PostgreSQL (tenants.p12_binary) for stateless cloud deployments.
CERTIFICATES_STORAGE_DIR="./storage/certificates"

# Certificate validation & CRL revocation settings:
# Set CRL_CHECK_ENABLED=true (default) to check X.509 CRL distribution points when present in the certificate.
CRL_CHECK_ENABLED=true
# Set CRL_STRICT_MODE=true to reject certificate registration if the CA's CRL server is temporarily offline.
CRL_STRICT_MODE=false
# Optional comma-separated list of revoked certificate serial numbers (hex or decimal):
REVOKED_CERT_SERIALS=""
# Set ALLOW_UNRECOGNIZED_CA=true ONLY in isolated local sandboxes if testing with non-Ecuadorian CAs:
ALLOW_UNRECOGNIZED_CA=false

# Initial API Key used when running `pnpm run prisma:seed` (stored as SHA-256 hash in DB)
SEED_TENANT_API_KEY="sri_live_demo_tenant_api_key_2026"

# ------------------------------------------------------------------------------
# 5. Ecuadorian SRI SOAP 1.1 Web Services (Offline Scheme)
# ------------------------------------------------------------------------------
# Ambiente "1" — Pruebas (Certificación - celcer.sri.gob.ec)
SRI_TEST_RECEPCION_URL="https://celcer.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline"
SRI_TEST_AUTORIZACION_URL="https://celcer.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline"

# Ambiente "2" — Producción (cel.sri.gob.ec)
SRI_PROD_RECEPCION_URL="https://cel.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline"
SRI_PROD_AUTORIZACION_URL="https://cel.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline"

# ------------------------------------------------------------------------------
# 6. Outbound Webhook Dispatcher (SaaS Notification)
# ------------------------------------------------------------------------------
# REQUIRED in production: Secret key used to sign outbound webhooks via HMAC-SHA256 (`X-SRI-Gateway-Signature`)
# Generate with: node -e "console.log('whsec_' + require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SIGNING_SECRET="whsec_sri_gateway_default_secret_key"

# Maximum timeout (in milliseconds) when dispatching webhook POST notifications
WEBHOOK_TIMEOUT_MS=10000

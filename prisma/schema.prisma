generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiClient {
  id           String    @id @default(uuid())
  name         String
  ruc          String?   @unique @db.VarChar(13)
  apiKeyHash    String    @unique @map("api_key_hash") @db.VarChar(64)
  webhookUrl    String?   @map("webhook_url")
  webhookSecret String?   @map("webhook_secret") @db.VarChar(128)
  status       String    @default("ACTIVE")
  plan         String    @default("STANDARD")
  rateLimitRps Int       @default(100) @map("rate_limit_rps")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  tenants      Tenant[]

  @@map("api_clients")
}

model Tenant {
  id           String        @id @default(uuid())
  apiClientId  String        @map("api_client_id")
  apiClient    ApiClient     @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  businessName String        @map("business_name")
  ruc          String        @db.VarChar(13)
  status       String        @default("ACTIVE")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  certificates Certificate[]
  invoiceJobs  InvoiceJob[]

  @@unique([apiClientId, ruc])
  @@index([apiClientId])
  @@map("tenants")
}

model Certificate {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  p12Binary          Bytes?   @map("p12_binary")
  p12FilePath        String?  @map("p12_file_path")
  passwordCiphertext String   @map("password_ciphertext")
  passwordIv         String   @map("password_iv")
  passwordAuthTag    String   @map("password_auth_tag")
  validFrom          DateTime @map("cert_valid_from")
  validTo            DateTime @map("cert_valid_to")
  certSubject        String   @map("cert_subject")
  certIssuer         String   @map("cert_issuer")
  serialNumber       String?  @map("serial_number")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([tenantId, isActive])
  @@map("certificates")
}

model InvoiceJob {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referenceId           String    @map("reference_id")
  codDoc                String    @default("01") @map("cod_doc") @db.VarChar(2)
  claveAcceso           String    @unique @map("clave_acceso") @db.VarChar(49)
  ambiente              String    @db.VarChar(1)
  status                String    @default("QUEUED")
  webhookUrl            String    @map("webhook_url")
  payloadJson           Json      @map("payload_json")
  unsignedXml           String?   @map("unsigned_xml") @db.Text
  signedXml             String?   @map("signed_xml") @db.Text
  authorizedXml         String?   @map("authorized_xml") @db.Text
  numeroAutorizacion    String?   @map("numero_autorizacion")
  fechaAutorizacion     DateTime? @map("fecha_autorizacion")
  sriMessages           Json?     @map("sri_messages")
  webhookDelivered      Boolean   @default(false) @map("webhook_delivered")
  webhookResponseStatus Int?      @map("webhook_response_status")
  attempts              Int       @default(0)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, referenceId])
  @@index([status])
  @@map("invoice_jobs")
}

// ============================================================================
// Global Public SRI Tax Catalogs & Taxpayer Profile Cache (Tenant-Agnostic)
// ============================================================================

enum SriCatalogSource {
  AGENTS
  SPECIAL
  RIMPE
}

enum SriSyncStatus {
  IDLE
  SYNCING
  SUCCEEDED
  FAILED
}

enum SriRegimenType {
  GENERAL
  RIMPE_EMPRENDEDOR
  RIMPE_NEGOCIO_POPULAR
}

model SriCatalogSyncState {
  source           SriCatalogSource @id
  packageSlug      String           @map("package_slug") @db.VarChar(120)
  resourceId       String?          @map("resource_id") @db.VarChar(80)
  resourceUrl      String?          @map("resource_url") @db.Text
  etag             String?          @db.VarChar(128)
  lastModified     String?          @map("last_modified") @db.VarChar(80)
  remoteModifiedAt String?          @map("remote_modified_at") @db.VarChar(80)
  contentLength    Int?             @map("content_length")
  fileSha256       String?          @map("file_sha256") @db.VarChar(64)
  rowCount         Int              @default(0) @map("row_count")
  status           SriSyncStatus    @default(IDLE)
  lastError        String?          @map("last_error") @db.Text
  lastCheckedAt    DateTime?        @map("last_checked_at")
  lastSyncedAt     DateTime?        @map("last_synced_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("sri_catalog_sync_states")
}

model SriTaxpayerSpecial {
  ruc                 String         @id @db.VarChar(13)
  razonSocial         String?        @map("razon_social") @db.VarChar(300)
  regimen             SriRegimenType @default(GENERAL)
  isSpecialTaxpayer   Boolean        @default(false) @map("is_special_taxpayer")
  specialTaxpayerRes  String?        @map("special_taxpayer_res") @db.VarChar(30)
  isWithholdingAgent  Boolean        @default(false) @map("is_withholding_agent")
  withholdingAgentRes String?        @map("withholding_agent_res") @db.VarChar(30)
  obligatedAccounting Boolean?       @map("obligated_accounting")
  taxpayerState       String?        @map("taxpayer_state") @db.VarChar(40)
  inAgentsCatalog     Boolean        @default(false) @map("in_agents_catalog")
  inSpecialCatalog    Boolean        @default(false) @map("in_special_catalog")
  inRimpeCatalog      Boolean        @default(false) @map("in_rimpe_catalog")
  agentsBatchId       String?        @map("agents_batch_id") @db.VarChar(64)
  specialBatchId      String?        @map("special_batch_id") @db.VarChar(64)
  rimpeBatchId        String?        @map("rimpe_batch_id") @db.VarChar(64)
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([regimen])
  @@index([isWithholdingAgent])
  @@index([isSpecialTaxpayer])
  @@map("sri_taxpayer_specials")
}

model SriTaxpayerProfile {
  ruc                 String         @id @db.VarChar(13)
  razonSocial         String         @map("razon_social") @db.VarChar(300)
  nombreComercial     String?        @map("nombre_comercial") @db.VarChar(300)
  tipoPersona         String         @map("tipo_persona") @db.VarChar(20)
  tipoContribuyente   String?        @map("tipo_contribuyente") @db.VarChar(120)
  regimen             SriRegimenType @default(GENERAL)
  obligatedAccounting Boolean        @default(false) @map("obligated_accounting")
  isSpecialTaxpayer   Boolean        @default(false) @map("is_special_taxpayer")
  specialTaxpayerRes  String?        @map("special_taxpayer_res") @db.VarChar(30)
  isWithholdingAgent  Boolean        @default(false) @map("is_withholding_agent")
  withholdingAgentRes String?        @map("withholding_agent_res") @db.VarChar(30)
  taxpayerState       String         @default("ACTIVO") @map("taxpayer_state") @db.VarChar(40)
  actividadEconomica  String?        @map("actividad_economica") @db.VarChar(300)
  direccionMatriz     String?        @map("direccion_matriz") @db.VarChar(300)
  source              String         @db.VarChar(30)
  fetchedAt           DateTime       @default(now()) @map("fetched_at")
  expiresAt           DateTime       @map("expires_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("sri_taxpayer_profiles")
}
